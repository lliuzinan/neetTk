NEXT_PUBLIC_SITE_URL=https://medqgo.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Public AdSense publisher identifier. Example: ca-pub-1234567890123456
# Leave unset until you create or access the AdSense account.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX

# Optional: Google Search Console automation
GSC_SITE_URL=https://medqgo.com/
GSC_SERVICE_ACCOUNT_FILE=/absolute/path/to/google-service-account.json
# Or use raw JSON instead of a file path:
# GSC_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
